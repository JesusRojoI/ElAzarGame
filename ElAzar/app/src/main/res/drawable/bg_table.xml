<?xml version="1.0" encoding="utf-8"?>
<!-- Mesa de juego: fieltro oscuro con aro interior -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="@color/azar_brown_dark"
                android:endColor="#5C2500" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item android:left="6dp" android:top="6dp" android:right="6dp" android:bottom="6dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#55FFCCAA" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</layer-list>
