    <!-- ===================== Ayuda ===================== -->
    <string name="help_title">Ayuda</string>
    <string name="help_hero">¿En qué te ayudamos?</string>
    <string name="help_hero_body">Encuentra respuestas rápidas o escríbenos. Nuestro equipo de soporte está disponible todos los días.</string>
    <string name="help_faq">Preguntas frecuentes</string>
    <string name="help_q1">¿Cómo recargo mi saldo?</string>
    <string name="help_a1">Entra a “Mis tarjetas” desde el menú lateral y registra un medio de pago. En la versión final podrás recargar fichas al instante.</string>
    <string name="help_q2">¿Cómo cambio mi foto o mis datos?</string>
    <string name="help_a2">Abre tu perfil desde el menú lateral y toca “Editar perfil”. Puedes cambiar tu nombre, correo y nombre de usuario.</string>
    <string name="help_q3">¿Las partidas son contra personas reales?</string>
    <string name="help_a3">En este prototipo las partidas se simulan localmente. La versión completa conectará salas multijugador en tiempo real.</string>
    <string name="help_q4">¿Cómo solicito la eliminación de mi cuenta?</string>
    <string name="help_a4">Escríbenos a soporte@elazar.mx y solicita la baja. Tus datos se eliminarán conforme a la política de privacidad.</string>
    <string name="help_contact">Contacto y soporte</string>
    <string name="help_contact_body">soporte@elazar.mx · Lunes a domingo, 9:00 a 21:00 h.</string>
    <string name="help_write">Escríbenos</string>
    <string name="help_privacy">Política de privacidad</string>
