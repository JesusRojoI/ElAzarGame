<?xml version="1.0" encoding="utf-8"?>
<!--
    Vista 3. Página principal (dashboard).
    El usuario puede seleccionar cualquiera de los juegos de azar.
    Práctica 8: DrawerLayout + NavigationView (menú lateral) sobre ConstraintLayout
    y un FrameLayout para apilar el ícono de saldo detrás del texto.
-->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/azar_background"
    android:fitsSystemWindows="true"
    tools:context=".DashboardActivity"
    tools:openDrawer="start">

    <!-- ===================== Contenido principal ===================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@drawable/bg_topbar"
            android:elevation="4dp"
            android:theme="@style/ThemeOverlay.ElAzar.Toolbar"
            app:title="@string/app_name"
            app:titleTextColor="@color/white" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollDashboard"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:descendantFocusability="beforeDescendants"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:paddingBottom="@dimen/space_lg">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/screen_margin"
                android:paddingEnd="@dimen/screen_margin"
                android:paddingTop="@dimen/space_md">

                <!-- ===== Saludo ===== -->
                <ImageView
                    android:id="@+id/imageAvatar"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_circle_cream"
                    android:contentDescription="@string/nav_profile"
                    android:padding="4dp"
                    android:src="@drawable/ic_avatar"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/textGreeting"
                    style="@style/Azar_font.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:maxLines="1"
                    android:text="@string/greeting"
                    android:textSize="20sp"
                    app:layout_constraintBottom_toBottomOf="@id/imageAvatar"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/imageAvatar"
                    app:layout_constraintTop_toTopOf="@id/imageAvatar"
                    tools:text="Hola, @usuario.G 👋" />

                <!-- ===== Tarjeta de saldo (FrameLayout: capa del ícono + capa de texto) ===== -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardBalance"
                    style="@style/Widget.ElAzar.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    app:cardBackgroundColor="@color/azar_brown"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/imageAvatar"
                    app:strokeWidth="0dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/space_md">

                        <ImageView
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:layout_gravity="end|center_vertical"
                            android:alpha="0.9"
                            android:contentDescription="@string/dashboard_balance"
                            android:src="@drawable/ic_coin" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Azar_font.Label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/dashboard_balance"
                                android:textColor="@color/azar_cream" />

                            <TextView
                                android:id="@+id/textBalance"
                                style="@style/Azar_font.Display"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/white"
                                android:textSize="32sp"
                                tools:text="$ 1,250.00" />

                            <TextView
                                android:id="@+id/textOnline"
                                style="@style/Azar_font.Body"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/azar_cream"
                                tools:text="1 284 jugadores en línea" />
                        </LinearLayout>
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ===== Título de sección + filtros ===== -->
                <TextView
                    android:id="@+id/textChoose"
                    style="@style/Azar_font.Heading"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:text="@string/dashboard_choose"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/cardBalance" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupFilter"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    app:singleLine="true"
                    app:singleSelection="true"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/textChoose">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipAll"
                        style="@style/Widget.ElAzar.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/dashboard_section_all" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipPopular"
                        style="@style/Widget.ElAzar.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dashboard_section_popular" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipLive"
                        style="@style/Widget.ElAzar.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/filter_live" />
                </com.google.android.material.chip.ChipGroup>

                <!-- ===== Rejilla de juegos (GridLayoutManager de 2 columnas) ===== -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerGames"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:nestedScrollingEnabled="false"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/chipGroupFilter"
                    tools:itemCount="4"
                    tools:listitem="@layout/item_game" />

                <!-- ===== Jugadores en línea ===== -->
                <TextView
                    android:id="@+id/textPlayersTitle"
                    style="@style/Azar_font.Heading"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:text="@string/snakes_players"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/recyclerGames" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerPlayers"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:clipToPadding="false"
                    android:paddingEnd="@dimen/space_md"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    app:orientation="horizontal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/textPlayersTitle"
                    tools:listitem="@layout/item_player" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <!-- ===================== Menú lateral ===================== -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        app:headerLayout="@layout/nav_header"
        app:itemIconTint="@color/azar_brown"
        app:itemTextColor="@color/azar_text_primary"
        app:menu="@menu/menu_drawer" />
</androidx.drawerlayout.widget.DrawerLayout>
