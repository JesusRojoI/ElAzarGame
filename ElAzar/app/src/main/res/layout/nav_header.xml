<?xml version="1.0" encoding="utf-8"?>
<!-- Encabezado del menú lateral (NavigationView) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_topbar"
    android:gravity="bottom"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_md"
    android:paddingEnd="@dimen/space_md"
    android:paddingTop="@dimen/space_xl"
    android:paddingBottom="@dimen/space_md">

    <ImageView
        android:id="@+id/imageNavAvatar"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_circle_cream"
        android:contentDescription="@string/nav_profile"
        android:padding="4dp"
        android:src="@drawable/ic_avatar" />

    <TextView
        android:id="@+id/textNavUser"
        style="@style/Azar_font.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:text="@string/nav_profile" />

    <TextView
        android:id="@+id/textNavSubtitle"
        style="@style/Azar_font.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/drawer_header_sub"
        android:textColor="@color/azar_cream" />

    <TextView
        android:id="@+id/textNavBalance"
        style="@style/Azar_font.Body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:background="@drawable/bg_pill_cream"
        android:drawablePadding="6dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:textColor="@color/azar_brown"
        android:textStyle="bold"
        app:drawableStartCompat="@drawable/ic_coin"
        tools:text="$ 1,250.00" />
</LinearLayout>
