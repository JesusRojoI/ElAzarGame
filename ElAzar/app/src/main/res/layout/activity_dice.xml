<?xml version="1.0" encoding="utf-8"?>
<!--
    Vista 7. Juego "Dados M".
    El usuario juega contra otro jugador (1 vs 1) o contra la computadora (1 vs PC).
    Práctica 7: RadioGroup / RadioButton para elegir cuántos dados, Button y TextView de resultado.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/azar_background"
    android:fillViewport="true"
    tools:context=".DiceGameActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/space_lg">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="0dp"
            android:layout_height="?attr/actionBarSize"
            android:background="@drawable/bg_topbar"
            android:theme="@style/ThemeOverlay.ElAzar.Toolbar"
            app:title="@string/dice_title"
            app:titleTextColor="@color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- ===== Mesa de juego ===== -->
        <LinearLayout
            android:id="@+id/layoutTable"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_margin"
            android:layout_marginEnd="@dimen/screen_margin"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/bg_table"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/space_lg"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/toolbar">

            <TextView
                style="@style/Azar_font.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dice_tap_hint"
                android:textColor="@color/azar_cream" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textDie1"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_dice_face"
                    android:gravity="center"
                    android:text="@string/rps_gesture_none"
                    android:textColor="@color/azar_brown"
                    android:textSize="34sp"
                    tools:text="⚄" />

                <TextView
                    android:id="@+id/textDie2"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginStart="@dimen/space_sm"
                    android:background="@drawable/bg_dice_face"
                    android:gravity="center"
                    android:text="@string/rps_gesture_none"
                    android:textColor="@color/azar_brown"
                    android:textSize="34sp"
                    tools:text="⚂" />

                <TextView
                    android:id="@+id/textDie3"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginStart="@dimen/space_sm"
                    android:background="@drawable/bg_dice_face"
                    android:gravity="center"
                    android:text="@string/rps_gesture_none"
                    android:textColor="@color/azar_brown"
                    android:textSize="34sp"
                    android:visibility="gone"
                    tools:text="⚁"
                    tools:visibility="visible" />
            </LinearLayout>

            <TextView
                android:id="@+id/textResult"
                style="@style/Azar_font.Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:gravity="center"
                android:text="@string/dice_tap_hint"
                android:textColor="@color/white" />

            <TextView
                android:id="@+id/textRolls"
                style="@style/Azar_font.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/azar_cream"
                tools:text="Lanzamientos: 0" />

            <TextView
                android:id="@+id/textBetTotal"
                style="@style/Azar_font.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:background="@drawable/bg_pill_cream"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:textColor="@color/azar_brown"
                android:textStyle="bold"
                tools:text="Apuesta total: $ 25.00" />
        </LinearLayout>

        <!-- ===== Opciones de número de dados (RadioGroup, Práctica 7) ===== -->
        <TextView
            android:id="@+id/textCountLabel"
            style="@style/Azar_font.Label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_margin"
            android:layout_marginEnd="@dimen/screen_margin"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/dice_choose_count"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutTable" />

        <RadioGroup
            android:id="@+id/groupDiceCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_margin"
            android:layout_marginEnd="@dimen/screen_margin"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textCountLabel">

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/radioOne"
                style="@style/Widget.ElAzar.RadioButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:onClick="onRollClicked"
                android:text="@string/dice_option_1" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/radioTwo"
                style="@style/Widget.ElAzar.RadioButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:onClick="onRollClicked"
                android:text="@string/dice_option_2" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/radioThree"
                style="@style/Widget.ElAzar.RadioButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:onClick="onRollClicked"
                android:text="@string/dice_option_3" />
        </RadioGroup>

        <!-- ===== Botonera ===== -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonRoll"
            style="@style/Widget.ElAzar.Button"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_marginStart="@dimen/screen_margin"
            android:layout_marginEnd="@dimen/screen_margin"
            android:layout_marginTop="@dimen/space_md"
            android:onClick="onRollClicked"
            android:text="@string/dice_roll"
            app:icon="@drawable/ic_game_dice"
            app:iconGravity="textStart"
            app:iconSize="20dp"
            app:iconTint="@null"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/groupDiceCount" />

        <LinearLayout
            android:id="@+id/rowExtras"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_margin"
            android:layout_marginEnd="@dimen/screen_margin"
            android:layout_marginTop="@dimen/space_sm"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/buttonRoll">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonSkins"
                style="@style/Widget.ElAzar.Button.Tonal"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="@dimen/space_sm"
                android:layout_weight="1"
                android:text="@string/dice_skins" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonRooms"
                style="@style/Widget.ElAzar.Button.Tonal"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/dice_rooms" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowModes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_margin"
            android:layout_marginEnd="@dimen/screen_margin"
            android:layout_marginTop="@dimen/space_sm"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/rowExtras">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonOneVsOne"
                style="@style/Widget.ElAzar.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="@dimen/space_sm"
                android:layout_weight="1"
                android:text="@string/dice_1v1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonOneVsPc"
                style="@style/Widget.ElAzar.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/dice_1vpc" />
        </LinearLayout>

        <TextView
            android:id="@+id/textDataProtection"
            style="@style/Azar_font.Body.Muted"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_margin"
            android:layout_marginEnd="@dimen/screen_margin"
            android:layout_marginTop="@dimen/space_lg"
            android:background="@drawable/bg_pill_cream"
            android:gravity="center"
            android:padding="@dimen/space_sm"
            android:text="@string/data_protection"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/rowModes" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
