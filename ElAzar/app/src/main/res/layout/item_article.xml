<?xml version="1.0" encoding="utf-8"?>
<!-- Artículo de la tienda -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.ElAzar.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_sm">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_sm">

        <ImageView
            android:id="@+id/imageArticle"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_circle_cream"
            android:contentDescription="@string/store_title"
            android:padding="6dp"
            tools:src="@drawable/ic_game_dice" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textArticleName"
                style="@style/Azar_font.Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                tools:text="Artículo 1" />

            <TextView
                android:id="@+id/textArticlePrice"
                style="@style/Azar_font.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/azar_orange"
                android:textStyle="bold"
                tools:text="$ 120.00" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonBuy"
            style="@style/Widget.ElAzar.Button.Tonal"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="@string/store_buy"
            android:textSize="13sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
