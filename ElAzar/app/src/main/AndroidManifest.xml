<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- El Azar: juego de azar multijugador en tiempo real. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ElAzar"
        tools:targetApi="31">

        <!-- 1. Pantalla de inicio de sesión -->
        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2. Registro de cuenta nueva -->
        <activity
            android:name=".RegisterActivity"
            android:exported="false"
            android:parentActivityName=".LoginActivity" />

        <!-- 2b. Recuperación de contraseña -->
        <activity
            android:name=".ForgotPasswordActivity"
            android:exported="false"
            android:parentActivityName=".LoginActivity" />

        <!-- 3. Tablero principal / dashboard -->
        <activity
            android:name=".DashboardActivity"
            android:exported="false"
            android:label="@string/title_dashboard" />

        <!-- 4. Alta de medio de pago (tarjeta) -->
        <activity
            android:name=".PaymentActivity"
            android:exported="false"
            android:parentActivityName=".DashboardActivity" />

        <!-- 5. Tienda de artículos y promociones -->
        <activity
            android:name=".StoreActivity"
            android:exported="false"
            android:parentActivityName=".DashboardActivity" />

        <!-- 6. Juego: Dados M -->
        <activity
            android:name=".DiceGameActivity"
            android:exported="false"
            android:parentActivityName=".DashboardActivity" />

        <!-- 7. Juego: Serpientes y Escaleras -->
        <activity
            android:name=".SnakesActivity"
            android:exported="false"
            android:parentActivityName=".DashboardActivity" />

        <!-- 8. Juego: Piedra, papel o tijera con apuesta -->
        <activity
            android:name=".RpsActivity"
            android:exported="false"
            android:parentActivityName=".DashboardActivity" />

        <!-- 9. Juego: Disparos -->
        <activity
            android:name=".ShooterActivity"
            android:exported="false"
            android:parentActivityName=".DashboardActivity" />

        <!-- 10. Juego: Mano de Póker (vista adicional) -->
        <activity
            android:name=".PokerActivity"
            android:exported="false"
            android:parentActivityName=".DashboardActivity" />

        <!-- 11. Juego: Ruleta (vista adicional) -->
        <activity
            android:name=".RouletteActivity"
            android:exported="false"
            android:parentActivityName=".DashboardActivity" />

        <!-- 12. Perfil editable del jugador (vista adicional) -->
        <activity
            android:name=".ProfileActivity"
            android:exported="false"
            android:parentActivityName=".DashboardActivity" />

        <!-- 13. Historial de partidas (vista adicional) -->
        <activity
            android:name=".HistoryActivity"
            android:exported="false"
            android:parentActivityName=".DashboardActivity" />

        <!-- 14. Centro de ayuda (vista adicional) -->
        <activity
            android:name=".HelpActivity"
            android:exported="false"
            android:parentActivityName=".DashboardActivity" />
    </application>

</manifest>
